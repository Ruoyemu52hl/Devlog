---
import { PageHeader } from "@components/features/page-header";
import Markdown from "@components/misc/Markdown.astro";

import GameExperienceContent, {
	frontmatter,
} from "../content/spec/game-experience.md";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const title =
	typeof frontmatter.title === "string" ? frontmatter.title : "游戏经历";
const description =
	typeof frontmatter.description === "string"
		? frontmatter.description
		: "记录玩过的游戏、体验和截图。";
---

<MainGridLayout title={title} description={description}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<PageHeader title={title} subtitle={description} />

			<Markdown class="mt-2">
				<GameExperienceContent />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
